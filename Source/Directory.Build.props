<Project>
    <PropertyGroup>
        <RimworldVersion>1.7</RimworldVersion>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Update="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.2" />
        <PackageReference Update="Lib.Harmony.Ref" Version="3.0.0-rc.3" />
    </ItemGroup>
</Project>
