<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>VMM_VanillaMeleeModes.Patch_CombatExtended</RootNamespace>
        <AssemblyName>zz.VMM.Patch_CombatExtended</AssemblyName>
        <Version>1.2.3</Version>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\..\..\ModPatches\CombatExtended\$(RimworldVersion)\Assemblies\</OutputPath>
        <DebugType>none</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\VanillaMeleeModes\VanillaMeleeModes.csproj" >
            <Private>False</Private>
            <CopyLocal>False</CopyLocal>
            <ExcludeAssets>all</ExcludeAssets>
        </ProjectReference>
        <Reference Include="CombatExtended">
            <HintPath>ref\CombatExtended.dll</HintPath>
            <Private>False</Private>
            <CopyLocal>False</CopyLocal>
            <ExcludeAssets>runtime</ExcludeAssets>
        </Reference>
    </ItemGroup>
    <Target Name="BundleMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <VMMBundleScript>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'LoadFolders.xml'))\Scripts\Bundle-Mod.ps1</VMMBundleScript>
        </PropertyGroup>
        <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(VMMBundleScript)&quot;" />
    </Target>
</Project>
